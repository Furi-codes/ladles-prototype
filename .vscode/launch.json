{
    // Optional VS Code browser-debug profile. It opens the URL below; it does not start Next.js.
    // This profile currently targets port 8080. The running server must use that port,
    // or this URL must be changed to match the server's port (npm run dev normally uses 3000).
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Chrome against localhost",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}"
        }
    ]
}
